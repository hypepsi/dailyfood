# 复制为 /etc/loseweight/env（生产）或 .env.local（开发），不要提交真实值
OPENAI_API_KEY=
# 识图与聊天使用的模型
OPENAI_MODEL=gpt-6-astra
# 语音记录用的语音转文字模型
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# 数据目录：SQLite 数据库、图片、备份都在这里
DATA_DIR=/var/lib/loseweight
# 对外访问地址，用于校验请求来源
APP_ORIGIN=https://lw.example.com
# 原图保留天数，超过后只保留缩略图
IMAGE_RETENTION_DAYS=90
# 每个用户每天最多 AI 调用次数（防止费用失控）
AI_DAILY_LIMIT=200
