[Unit]
Description=LoseWeight daily maintenance (backup + cleanup)

[Service]
Type=oneshot
User=loseweight
Group=loseweight
WorkingDirectory=/opt/loseweight
EnvironmentFile=/etc/loseweight/env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs scripts/maintenance.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/loseweight
